# Label Ledger — Supabase Environment Configuration
# Copy this file to .env.local for local development.
# DO NOT commit real secrets or service keys to Git.

# Supabase Project Credentials (obtain from Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (SERVER SIDE ONLY - NEVER EXPOSE TO BROWSER CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Feature Toggle: Set to "true" to force mock data mode, or "false" to use live Supabase data.
# Defaults to "true" if NEXT_PUBLIC_SUPABASE_URL is not set.
NEXT_PUBLIC_USE_MOCK_DATA=true
